#!/usr/bin/env bash
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
PROJECT_ROOT="$(realpath "$SCRIPT_DIR/../../")"
if [ -f "$PROJECT_ROOT/.env" ]; then
  set -a
  source "$PROJECT_ROOT/.env"
  set +a
fi

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
printf "${CYAN}== db-schema-load${NO_COLOR}\n"

SCHEMA_PATH="$SCRIPT_DIR/../db/schema.sql"

if [ "$1" = "prod" ]; then
  printf "${CYAN}== using production database (PROD_CONNECTION_URL)${NO_COLOR}\n"
  DB_CONNECTION_URL="$PROD_CONNECTION_URL"
else
  DB_CONNECTION_URL="$CONNECTION_URL"
fi

psql "$DB_CONNECTION_URL" -f "$SCHEMA_PATH"
