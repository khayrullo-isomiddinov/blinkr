#!/usr/bin/env bash
# Demonstrates the event-driven architecture end to end against a running
# backend: create match -> add goal -> add yellow card -> add substitution
# -> half time -> add goal -> full time. Each step is a real HTTP call to
# the admin/demo match-event routes, so you can watch, in order:
#   event created -> match updated -> database updated -> clients polling
#   the match page pick up the change on their next refresh.
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
PROJECT_ROOT="$(realpath "$SCRIPT_DIR/../../")"
if [ -f "$PROJECT_ROOT/.env" ]; then
  set -a
  source "$PROJECT_ROOT/.env"
  set +a
fi

BACKEND_URL="${BACKEND_URL:-http://127.0.0.1:4567}"
CYAN='\033[1;36m'
NO_COLOR='\033[0m'

step() { printf "${CYAN}== %s${NO_COLOR}\n" "$1"; }

step "looking up two seeded teams to play a demo match"
TEAMS=$(curl -s "$BACKEND_URL/api/teams")
HOME_UUID=$(echo "$TEAMS" | python3 -c "import json,sys; print(json.load(sys.stdin)[0]['uuid'])")
AWAY_UUID=$(echo "$TEAMS" | python3 -c "import json,sys; print(json.load(sys.stdin)[1]['uuid'])")

step "start match (kickoff now, status=live)"
MATCH=$(curl -s -X POST "$BACKEND_URL/api/matches" \
  -H "Content-Type: application/json" \
  -d "{\"home_team_uuid\":\"$HOME_UUID\",\"away_team_uuid\":\"$AWAY_UUID\",\"competition\":\"Demo Cup\",\"status\":\"live\"}")
MATCH_UUID=$(echo "$MATCH" | python3 -c "import json,sys; print(json.load(sys.stdin)['uuid'])")
echo "$MATCH"
printf "\nmatch: %s\n\n" "$MATCH_UUID"

post_event() {
  curl -s -X POST "$BACKEND_URL/api/matches/$MATCH_UUID/events" -H "Content-Type: application/json" -d "$1"
  echo
}

step "add goal (home team, 12')"
post_event "{\"event_type\":\"GOAL\",\"minute\":12,\"team_uuid\":\"$HOME_UUID\",\"player_name\":\"Demo Striker\"}"

step "add yellow card (away team, 29')"
post_event "{\"event_type\":\"YELLOW_CARD\",\"minute\":29,\"team_uuid\":\"$AWAY_UUID\",\"player_name\":\"Demo Defender\"}"

step "add substitution (home team, 60')"
post_event "{\"event_type\":\"SUBSTITUTION\",\"minute\":60,\"team_uuid\":\"$HOME_UUID\",\"player_name\":\"Demo Sub\",\"detail\":\"on for Demo Striker\"}"

step "half time (45')"
post_event "{\"event_type\":\"HALF_TIME\",\"minute\":45}"

step "add goal (away team, 70')"
post_event "{\"event_type\":\"GOAL\",\"minute\":70,\"team_uuid\":\"$AWAY_UUID\",\"player_name\":\"Demo Forward\"}"

step "full time (90') -- also tightens any reaction expiry on this match"
post_event "{\"event_type\":\"FULL_TIME\",\"minute\":90}"

step "final match state"
curl -s "$BACKEND_URL/api/matches/$MATCH_UUID"
echo
