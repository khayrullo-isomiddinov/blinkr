#!/usr/bin/env bash
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
PROJECT_ROOT="$(realpath "$SCRIPT_DIR/../../")"
if [ -f "$PROJECT_ROOT/.env" ]; then
  set -a
  source "$PROJECT_ROOT/.env"
  set +a
fi

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
printf "${CYAN}== db-create${NO_COLOR}\n"

# must NOT include the database name -- can't create/drop a db while connected to it
NO_DB_CONNECTION_URL=$(echo "$CONNECTION_URL" | sed 's/\/cruddur//g')

psql "$NO_DB_CONNECTION_URL" -c "CREATE DATABASE cruddur;"
